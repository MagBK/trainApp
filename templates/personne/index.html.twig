{% extends 'template.html.twig' %}

{% block title %}Liste de personnes{% endblock %}

{% block body %}

<div class="row">
{% for personne in personnes %}
   <div class="card" style="max-width: 320px;">
   <div class="card-body">
    <h4 class="card-title">{{personne.name}}</h4>
    <p class="card-subtitle fg-3">{{personne.firstname}} {{personne.name}} </p>
    <p class="card-text">Age : {{personne.age}}</p>
    <a href="#">Todo</a>
   </div>
   </div>
 {% endfor %}
</div>
{% endblock %}
